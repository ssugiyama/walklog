{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "walklog",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // Tells lib/drizzle/db.ts to create a fresh DB client per request
    // instead of a module-level singleton, since Workers forbids reusing
    // a TCP socket across requests. This is the only var that belongs here:
    // it's a fixed property of this deployment target, not per-deployer
    // config. Everything else (SITE_NAME, DB_URL, FIREBASE_*, R2_*, ...) is
    // set via `wrangler secret put` instead - see README.md. Don't add
    // empty placeholders for those here: `wrangler types` infers a var's
    // *literal* value as its TypeScript type, and an empty string is not
    // the same as unset for the app's `?? 'default'` fallbacks.
    "CF_WORKERS": "true"
  },
  "hyperdrive": [
    {
      // Run `wrangler hyperdrive create walklog-db --connection-string="<supabase-connection-string>"`
      // (see README.md), then `export HYPERDRIVE_ID=<the id it prints>`. The
      // id itself isn't meaningful to share across deployments, so it isn't
      // hardcoded here - `pnpm run build`/`preview`/`deploy`/`cf-typegen` all
      // run scripts/render-wrangler-config.mjs first, which substitutes it
      // into a gitignored .wrangler.generated.jsonc that wrangler actually
      // reads. Hyperdrive terminates the actual TLS connection to Supabase
      // and pools it, so the app never sees DB_URL on this path (see
      // lib/drizzle/db.ts) - direct TLS from a Worker to Supabase hits
      // multiple options unsupported by Workers' TLS implementation
      // (rejectUnauthorized, ALPNProtocols) or hangs.
      "binding": "HYPERDRIVE",
      "id": "$HYPERDRIVE_ID"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Without this, requests to a path that matches a static/prerendered
    // asset (e.g. `/`, which is statically prerendered) are served directly
    // by the assets layer without ever invoking the Worker - so a Server
    // Action POST to that same path 500s before our code runs at all (and
    // never shows up in `wrangler tail`, since the Worker never saw it).
    "run_worker_first": true
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "walklog"
    }
  ]
}
