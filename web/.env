SITE_NAME=Walklog
SITE_DESCRIPTION=webapp for managing your walking logs
IMAGE_PREFIX=uploads
OPEN_USER_MODE=
# SHAPE_STYLES_JSON=path-to-shape-styles.json
SRID=4326
SRID_FOR_SIMILAR_SEARCH=32662
# FIREBASE_CONFIG=path-to-firebase-config.json
GOOGLE_API_KEY=
GOOGLE_API_VERSION=
FIREBASE_STORAGE=on
MAP_TYPE_IDS=roadmap,hybrid,terrain,gsi
# DEFAULT_CENTER=lat,lng
DEFAULT_ZOOM=12
MAP_ID=
# GOOGLE_APPLICATION_CREDENTIALS=path-to-google-credentials.json
THEME_COLOR="#3874cb"
# THEME_COLOR_LIGHT="#3874cb"
# THEME_COLOR_DARK="#3874cb"
DB_URL=postgres://user:password@host/db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=base64-encoded-ca
# DB_SSL_KEY=base64-encoded-key
# DB_SSL_CERT=base64-encoded-cert
# APP_VERSION=dev
