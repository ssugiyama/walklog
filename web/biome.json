    {
      "includes": ["**/*.test.{ts,tsx}", "**/__mocks__/**"],
      "javascript": {
        "globals": [
          "describe",
          "expect",
          "it",
          "vi",
          "test",
          "beforeAll",
          "afterAll",
          "beforeEach",
          "afterEach",
          "google"
        ]
      },
      "linter": { "rules": {} }
    },
    {
      "includes": ["bin/**/*.js"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
